# API: se conecta con el rol api (solo SELECT de lectura y EXECUTE de funciones).
DATABASE_URL=postgresql://api:api@localhost:5432/cocos
# Bootstrap (migraciones + funciones): necesita un rol administrador.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/cocos
# Contraseña que el bootstrap le pone al rol api.
API_DB_PASSWORD=api
PORT=3000
PG_POOL_MAX=10
# Espera máxima por una conexión libre del pool; al vencer se responde 503 TIMEOUT. El tiempo
# de cada escritura lo acota la base (statement_timeout del rol api y lock_timeout de la función).
PG_CONNECT_TIMEOUT_MS=2000
# Plazo local de cada consulta en el driver, por si la respuesta de la base nunca llega (red que
# descarta sin cerrar). Por encima del statement_timeout de 5 s: en condiciones normales manda la base.
PG_QUERY_TIMEOUT_MS=7000
# Endpoints /internal/*: deshabilitados si no hay token.
INTERNAL_TOKEN=dev-internal-token
# Commit desplegado: lo fija el deploy (D-29) y GET /health lo devuelve como release. Opcional.
# RELEASE=
# Bootstrap, lo fija el deploy: el release que atiende el entorno mientras corre ('' en el primer
# deploy). Sin definir, verifica el contrato de la API de todos los releases registrados (D-24).
# SERVING_RELEASE=
# Job periódico (limpieza de claves de idempotencia vencidas).
JOBS_ENABLED=false
# Cada cuánto corre esa limpieza, en ms. Por defecto, una hora.
# CLEANUP_EVERY_MS=3600000
# Una línea de log por request (método, ruta, status, ms); con false no se escribe. Por defecto, activo.
# LOG_REQUESTS=true
# Bootstrap: carpeta con migrations/ y functions/, relativa al directorio de trabajo. Por defecto, db.
# DB_DIR=db
# Tests: servidor Postgres donde se crean las bases efímeras cocos_test y cocos_bootstrap_test.
TEST_PG_URL=postgresql://postgres:postgres@localhost:5432/postgres
