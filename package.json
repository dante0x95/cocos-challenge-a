{
  "name": "cocos-challenge-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de portfolio, búsqueda de activos y órdenes para el challenge de backend de Cocos.",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "SKIP_DB_SETUP=1 vitest run test/unit",
    "test:db": "vitest run test/db test/concurrency test/property test/bootstrap",
    "hooks:install": "git config core.hooksPath scripts/githooks"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
